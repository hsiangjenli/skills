# ICS Manager - environment configuration
#
# Copy this file to .env and fill in your values.
# Place .env in the directory where you run uv run commands,
# or at ~/.config/ics-manager/.env for a user-level default.
#
# Values here will NOT override variables already exported in your shell.

# Default ICS source: local file path or HTTP(S) URL
ICS_SOURCE=~/calendar/work.ics
# ICS_SOURCE=https://example.com/calendar.ics
