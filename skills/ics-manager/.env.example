# ICS Manager - environment configuration
#
# Copy this file to .env and fill in your values.
# Place .env in the directory where you run uv run commands,
# or at ~/.config/ics-manager/.env for a user-level default.
#
# Values here will NOT override variables already exported in your shell.

# Default ICS source(s): local file path or HTTP(S) URL
# Separate multiple sources with commas or new lines.
ICS_SOURCE=~/calendar/work.ics,~/calendar/personal.ics
# ICS_SOURCE=https://example.com/work.ics,https://example.com/team.ics

# Optional anchored default range for recurring check-ins.
# When set, read commands default to the active window that started here.
# Useful for Scrum sprints that always span the same number of days.
# Set ICS_RANGE_START to the date your first sprint began; every subsequent
# sprint window is derived automatically from that anchor.
# ICS_RANGE_START=2026-05-01
# ICS_RANGE_DAYS=14

# Backward-compatible aliases for sprint naming (same meaning as above).
# ICS_SPRINT_START=2026-05-01
# ICS_SPRINT_DAYS=14
